{
  "name": "oc-archive",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "build:pages": "npm --prefix client run build:pages",
    "preview:pages": "npm --prefix client run preview -- --base=/characterhubtrucho/"
  },
  "devDependencies": { "concurrently": "^9.1.2" }
}
